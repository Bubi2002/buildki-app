{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "protoKI Construction Analysis",
  "type": "object",
  "required": [
    "analysis_status",
    "room",
    "construction_phase",
    "progress_percent",
    "observations",
    "missing_or_open",
    "potential_defects",
    "next_steps",
    "overall_confidence"
  ],
  "properties": {
    "analysis_status": {
      "type": "string",
      "enum": [
        "completed",
        "needs_review",
        "insufficient_input"
      ]
    },
    "room": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "construction_phase": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "progress_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "confidence",
          "evidence_type"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "visible",
              "context_inference",
              "user_provided"
            ]
          }
        }
      }
    },
    "missing_or_open": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "potential_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "confidence",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "possible",
              "likely",
              "confirmed_by_user"
            ]
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
