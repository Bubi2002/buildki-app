# EAS Build ignore — mirrors .gitignore, plus excludes the lockfile so the
# macOS builder runs `npm install` (not `npm ci`) and resolves the correct
# platform-specific native binaries (e.g. lightningcss darwin-arm64).

# dependencies
node_modules/

# lockfile — force `npm install` on the build machine (platform-correct binaries)
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
!tests/fixtures/*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# OS
Thumbs.db

# Build files
*.tgz
*.tar.gz
.cache/

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json
